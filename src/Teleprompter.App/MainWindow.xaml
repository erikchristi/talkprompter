<Window x:Class="Teleprompter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TalkPrompter"
        Icon="Assets/app.ico"
        Height="780" Width="1180" MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        FontFamily="Segoe UI"
        KeyDown="OnWindowKeyDown"
        AllowDrop="True" PreviewDragOver="OnPreviewDragOver" PreviewDrop="OnPreviewDrop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar at the BOTTOM: the text hugs the top edge, closest to the
             webcam, so the app can sit right under the camera as a strip. -->
        <Border Grid.Row="1" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderCol}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <DockPanel LastChildFill="True">
                    <!-- Status pill -->
                    <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceAlt}"
                            BorderBrush="{DynamicResource BorderCol}" BorderThickness="1"
                            CornerRadius="8" Padding="14,0" Margin="10,2,0,2" MinHeight="34"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Mic level meter: proof audio is flowing -->
                            <Border Width="56" Height="6" CornerRadius="3" Background="{DynamicResource MeterTrack}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Microphone level">
                                <Border Width="{Binding MicLevelWidth}" MaxWidth="56" Height="6" CornerRadius="3"
                                        Background="{DynamicResource TrackingCol}" HorizontalAlignment="Left" />
                            </Border>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Muted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TrackingStateText}" Value="Tracking">
                                                <Setter Property="Fill" Value="{DynamicResource TrackingCol}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TrackingStateText}" Value="Paused">
                                                <Setter Property="Fill" Value="{DynamicResource PausedCol}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TrackingStateText}" Value="Lost">
                                                <Setter Property="Fill" Value="{DynamicResource LostCol}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextCol}"
                                       VerticalAlignment="Center" FontSize="13" MaxWidth="380"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding IsCompactToolbar, Converter={StaticResource InvBoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <WrapPanel>
                        <Button Content="{Binding ToggleLabel}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ToggleCommand}" MinWidth="100" Margin="0,2,8,2"
                                ToolTip="Start or stop voice tracking (Space)" />
                        <Button Content="Edit script" Style="{StaticResource GhostButton}"
                                Click="OnEditScript" Margin="0,2,8,2"
                                Visibility="{Binding IsCompactToolbar, Converter={StaticResource InvBoolToVis}}"
                                ToolTip="Open the script editor" />
                        <ComboBox ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript}"
                                  DisplayMemberPath="Name" MinWidth="130" MaxWidth="180"
                                  VerticalAlignment="Center" Margin="0,2,8,2"
                                  Visibility="{Binding IsCompactToolbar, Converter={StaticResource InvBoolToVis}}"
                                  ToolTip="Recent scripts - the reading position is remembered per script" />
                        <Button Content="Top" Style="{StaticResource GhostButton}"
                                Command="{Binding ResetPositionCommand}" Margin="0,2,8,2"
                                ToolTip="Scroll back to the top of the script (Home)" />
                        <!-- Narrow window: everything below lives in this menu instead -->
                        <ToggleButton x:Name="MenuToggle" Content="☰"
                                      Style="{StaticResource ToolToggle}" Margin="0,2,8,2"
                                      Visibility="{Binding IsCompactToolbar, Converter={StaticResource BoolToVis}}"
                                      ToolTip="More controls" />
                        <Popup PlacementTarget="{Binding ElementName=MenuToggle}" Placement="Top"
                               StaysOpen="False" VerticalOffset="-6"
                               IsOpen="{Binding IsChecked, ElementName=MenuToggle}">
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderCol}"
                                    BorderThickness="1" Padding="10">
                                <StackPanel ButtonBase.Click="OnCompactMenuItemClicked" Width="190">
                                    <ComboBox ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript}"
                                              DisplayMemberPath="Name" Margin="0,0,0,8"
                                              ToolTip="Recent scripts" />
                                    <Button Content="Edit script" Style="{StaticResource GhostButton}"
                                            Click="OnEditScript" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="A-" Style="{StaticResource GhostButton}"
                                                Click="OnFontSmaller" Margin="0,0,6,0" ToolTip="Smaller text" />
                                        <Button Content="A+" Style="{StaticResource GhostButton}"
                                                Click="OnFontLarger" ToolTip="Larger text" />
                                    </StackPanel>
                                    <Button Content="Mirror" Style="{StaticResource GhostButton}"
                                            Click="OnToggleMirror" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                            ToolTip="Flip horizontally for beam-splitter glass" />
                                    <Button Content="On top" Style="{StaticResource GhostButton}"
                                            Click="OnToggleTopmost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                            ToolTip="Keep this window above all others" />
                                    <Button Content="Camera" Style="{StaticResource GhostButton}"
                                            Click="OnToggleCameraMode" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                            ToolTip="Narrow always-on-top strip under your webcam" />
                                    <Button Content="Full screen" Style="{StaticResource GhostButton}"
                                            Click="OnToggleFullscreen" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            ToolTip="Full screen (F11, Esc to exit)" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Button Content="A-" Style="{StaticResource GhostButton}" Click="OnFontSmaller"
                                Margin="0,2,6,2" ToolTip="Smaller text"
                                Visibility="{Binding IsCompactToolbar, Converter={StaticResource InvBoolToVis}}" />
                        <Button Content="A+" Style="{StaticResource GhostButton}" Click="OnFontLarger"
                                Margin="0,2,8,2" ToolTip="Larger text"
                                Visibility="{Binding IsCompactToolbar, Converter={StaticResource InvBoolToVis}}" />
                        <ToggleButton x:Name="MirrorToggle" Content="Mirror" Click="OnToggleMirror"
                                      Style="{StaticResource ToolToggle}" Margin="0,2,8,2"
                                      Visibility="{Binding IsCompactToolbar, Converter={StaticResource InvBoolToVis}}"
                                      ToolTip="Flip horizontally for beam-splitter glass" />
                        <ToggleButton x:Name="TopmostToggle" Content="On top" Click="OnToggleTopmost"
                                      Style="{StaticResource ToolToggle}" Margin="0,2,8,2"
                                      Visibility="{Binding IsCompactToolbar, Converter={StaticResource InvBoolToVis}}"
                                      ToolTip="Keep this window above all others" />
                        <ToggleButton x:Name="CameraToggle" Content="Camera" Click="OnToggleCameraMode"
                                      Style="{StaticResource ToolToggle}" Margin="0,2,8,2"
                                      Visibility="{Binding IsCompactToolbar, Converter={StaticResource InvBoolToVis}}"
                                      ToolTip="Narrow always-on-top strip at the top of the screen, right under your webcam" />
                        <ToggleButton x:Name="FullToggle" Content="Full screen" Click="OnToggleFullscreen"
                                      Style="{StaticResource ToolToggle}" Margin="0,2,8,2"
                                      Visibility="{Binding IsCompactToolbar, Converter={StaticResource InvBoolToVis}}"
                                      ToolTip="Full screen (F11, Esc to exit)" />
                        <ToggleButton x:Name="SettingsToggle" Content="Settings"
                                      Style="{StaticResource ToolToggle}" Margin="0,2,0,2"
                                      ToolTip="Microphone, engine, and tracking options" />
                    </WrapPanel>
                </DockPanel>

                <!-- Settings popup -->
                <Popup PlacementTarget="{Binding ElementName=SettingsToggle}" Placement="Top"
                       StaysOpen="False" VerticalOffset="-6"
                       IsOpen="{Binding IsChecked, ElementName=SettingsToggle}"
                       Opened="OnSettingsPopupOpened">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderCol}"
                            BorderThickness="1" Padding="16,16,8,16" Width="320">
                        <!-- Taller than the window: scroll, never clip off-screen -->
                        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" MaxHeight="540"
                                      Padding="0,0,8,0">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Width" Value="9" />
                                    <Setter Property="MinWidth" Value="9" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollBar">
                                                <Grid Background="Transparent">
                                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Opacity="0" Focusable="False" IsTabStop="False" />
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Opacity="0" Focusable="False" IsTabStop="False" />
                                                        </Track.IncreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb Focusable="False">
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border Background="{DynamicResource ScrollThumb}" CornerRadius="3" />
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ScrollViewer.Resources>
                            <StackPanel>
                            <TextBlock Text="Language" Style="{StaticResource Label}" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ActiveLanguageSummary}" Foreground="{DynamicResource TextCol}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="Change…" Style="{StaticResource GhostButton}"
                                        Command="{Binding OpenLanguagePickerCommand}" Click="OnOpenLanguagePicker"
                                        Padding="10,5" FontSize="11" Margin="8,0,0,0"
                                        ToolTip="Pick the language you read in and download its voice pack" />
                            </Grid>

                            <TextBlock Text="Theme" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedThemeChoice}"
                                      Margin="0,0,0,14" />

                            <TextBlock Text="Microphone" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                      Margin="0,0,0,14" />

                            <TextBlock Text="Speech engine (takes effect on next Start)" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding EngineChoices}" SelectedItem="{Binding SelectedEngineChoice}"
                                      Margin="0,0,0,14" />

                            <TextBlock Text="Scroll smoothing (left = follows faster)" Style="{StaticResource Label}" />
                            <Slider Minimum="0.06" Maximum="0.35" Value="{Binding ScrollSmoothness}"
                                    Margin="0,0,0,14" />

                            <TextBlock Text="Tracking sensitivity (higher = follows through mistakes)"
                                       Style="{StaticResource Label}" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding Sensitivity}"
                                    Margin="0,0,0,14" />

                            <TextBlock Text="Column width (narrow hides eye movement on camera)"
                                       Style="{StaticResource Label}" />
                            <Slider Minimum="360" Maximum="1600" Value="{Binding ColumnWidth}"
                                    Margin="0,0,0,14" />

                            <CheckBox Content="Hide from screen recording (OBS, Zoom, Teams...)"
                                      IsChecked="{Binding HideFromCapture}"
                                      Foreground="{DynamicResource TextCol}" Margin="0,0,0,4" />
                            <TextBlock Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,4"
                                       Text="You see the prompter, your recording doesn't. Screenshots (Win+Shift+S) skip it too." />
                            <TextBlock Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,4"
                                       Text="Needs Windows 10 2004 or newer - here it shows as a black box instead."
                                       Visibility="{Binding CaptureProtectionSupported, Converter={StaticResource InvBoolToVis}}" />
                            <Border Height="6" />
                            <CheckBox Content="3-2-1 countdown on Start"
                                      IsChecked="{Binding CountdownEnabled}"
                                      Foreground="{DynamicResource TextCol}" Margin="0,0,0,8" />
                            <CheckBox Content="Reload the script when its file changes (Word sync)"
                                      IsChecked="{Binding FollowFileChanges}"
                                      Foreground="{DynamicResource TextCol}" Margin="0,0,0,8" />
                            <CheckBox Content="Show recognized words (debug strip)"
                                      IsChecked="{Binding ShowHeardText}"
                                      Foreground="{DynamicResource TextCol}" Margin="0,0,0,8" />
                            <CheckBox Content="Flow mode - glide through short pauses (experimental)"
                                      IsChecked="{Binding FlowModeEnabled}"
                                      Foreground="{DynamicResource TextCol}" Margin="0,0,0,8" />
                            <CheckBox Content="Simulation mode (no microphone)"
                                      IsChecked="{Binding ForceSimulation}"
                                      Foreground="{DynamicResource TextCol}" Margin="0,0,0,10" />

                            <TextBlock Text="{Binding EngineDescription}" Foreground="{DynamicResource Muted}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Tip: use Camera mode and place the strip as close to your webcam as possible. The shorter the gaze distance, the less eye movement your viewers see." />
                            <TextBlock Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"
                                       Text="Shortcuts: Space = start/stop. Ctrl+Alt+Space works from any app. Home = back to top. PageUp/PageDown = nudge 8 words. Ctrl+PageUp/PageDown = jump paragraphs. Click any word to re-anchor. F11 = full screen." />

                            <Border Height="1" Background="{DynamicResource BorderCol}" Margin="0,12,0,10" />

                            <Grid>
                                <TextBlock Foreground="{DynamicResource Muted}" FontSize="11"
                                           VerticalAlignment="Center">
                                    <Run Text="TalkPrompter " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                                </TextBlock>
                                <Button Content="Open settings folder" Style="{StaticResource GhostButton}"
                                        Command="{Binding OpenSettingsFolderCommand}"
                                        HorizontalAlignment="Right" Padding="10,5" FontSize="11" />
                            </Grid>
                            <TextBlock Foreground="{DynamicResource Muted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0" Text="Logikfusion" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- Prompter surface -->
        <Grid Grid.Row="0" ClipToBounds="True">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          SizeChanged="OnScrollerSizeChanged"
                          PreviewMouseWheel="OnPromptMouseWheel">
                <!-- Centered column: MaxWidth keeps lines short (5-7 words) so a
                     viewer cannot see the eyes sweep left-to-right.
                     Click any word to re-anchor the reader there.
                     The current word is marked by a box on a layer behind the
                     text: moving it never re-lays out the script. -->
                <Grid MaxWidth="{Binding ColumnWidth}" HorizontalAlignment="Center">
                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="WordMarker" Fill="{DynamicResource Highlight}"
                                   RadiusX="4" RadiusY="4" Visibility="Collapsed" />
                    </Canvas>
                    <TextBlock x:Name="Prompt" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextCol}"
                               FontSize="{Binding FontSize}" FontWeight="SemiBold"
                               Padding="24,0,24,0" TextAlignment="Left"
                               Cursor="Hand" MouseLeftButtonUp="OnPromptClicked"
                               SizeChanged="OnPromptSizeChanged" />
                </Grid>
            </ScrollViewer>

            <!-- Reading guide line at 33%; must match ReadingFraction in code-behind -->
            <Grid IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.33*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0.67*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="1" Height="2" Background="{DynamicResource Accent}" Opacity="0.35" />
                <Polygon Grid.Row="1" Points="0,-8 13,0 0,8" Fill="{DynamicResource Accent}"
                         Opacity="0.75" HorizontalAlignment="Left" Margin="10,0,0,0"
                         VerticalAlignment="Center" />
                <Polygon Grid.Row="1" Points="0,-8 -13,0 0,8" Fill="{DynamicResource Accent}"
                         Opacity="0.75" HorizontalAlignment="Right" Margin="0,0,10,0"
                         VerticalAlignment="Center" />
            </Grid>

            <!-- Live "what the engine hears" strip (toggle in Settings).
                 Only rendered when there is something to show, so no empty box. -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,0,12"
                    Background="{DynamicResource HeardStripBg}" BorderBrush="{DynamicResource BorderCol}" BorderThickness="1"
                    CornerRadius="6" Padding="10,5" IsHitTestVisible="False"
                    Visibility="{Binding HeardStripText, Converter={StaticResource NonEmptyToVis}}">
                <TextBlock Text="{Binding HeardStripText}" Foreground="{DynamicResource Muted}"
                           FontSize="13" FontFamily="Consolas" />
            </Border>

            <!-- Script editor overlay -->
            <Border x:Name="EditorPanel" Background="{DynamicResource Bg}" Visibility="Collapsed">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderCol}"
                        BorderThickness="1" CornerRadius="12" Margin="24">
                    <DockPanel Margin="16">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="Edit script" Foreground="{DynamicResource TextCol}"
                                           FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding EstimatedDuration}" Foreground="{DynamicResource Muted}"
                                           FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="New" Style="{StaticResource GhostButton}"
                                        Command="{Binding NewScriptCommand}" Margin="0,0,8,0"
                                        ToolTip="Start a new empty script (the current one stays in Recent)" />
                                <Button Content="Load file" Style="{StaticResource GhostButton}"
                                        Command="{Binding LoadFileCommand}"
                                        ToolTip="Load a script from a Word document (.docx) or text file (.txt)" />
                                <Button Content="Done" Style="{StaticResource PrimaryButton}"
                                        Click="OnDoneEditing" Padding="18,8" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBox Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" Foreground="{DynamicResource TextCol}"
                                 CaretBrush="{DynamicResource Accent}" BorderThickness="0"
                                 FontSize="16" Padding="4" />
                    </DockPanel>
                </Border>
            </Border>

            <!-- Language picker (also the first-run voice pack prompt) -->
            <Border Background="{DynamicResource OverlayScrim}"
                    Visibility="{Binding ShowModelPrompt, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderCol}"
                        BorderThickness="1" CornerRadius="14" Padding="26" Width="460"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding LanguageDialogTitle}" Foreground="{DynamicResource TextCol}"
                                   FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap"
                                   Margin="0,10,0,18" Text="{Binding LanguageDialogText}" />

                        <TextBlock Text="Language" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguageOption}"
                                  IsEnabled="{Binding CanPickLanguage}"
                                  MaxDropDownHeight="360" Margin="0,0,0,16" />

                        <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Maximum="100"
                                     Margin="0,0,0,8"
                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding DownloadStatus}" Foreground="{DynamicResource Muted}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"
                                   Visibility="{Binding DownloadStatus, Converter={StaticResource NonEmptyToVis}}" />

                        <Grid>
                            <Button Content="{Binding LanguageDismissText}" Style="{StaticResource GhostButton}"
                                    Command="{Binding DismissLanguagePickerCommand}" HorizontalAlignment="Left"
                                    ToolTip="You can pick a language later in Settings. Without a voice pack the app runs in simulation mode." />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Style="{StaticResource GhostButton}"
                                        Command="{Binding CancelDownloadCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                                <Button Content="{Binding LanguageActionText}" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ApplyLanguageCommand}" MinWidth="110" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Update available: changelog + accept or later -->
            <Border Background="{DynamicResource OverlayScrim}"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderCol}"
                        BorderThickness="1" CornerRadius="14" Padding="26" Width="470"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Update available" Foreground="{DynamicResource TextCol}"
                                   FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UpdateVersionText}" Foreground="{DynamicResource Muted}"
                                   FontSize="13" Margin="0,4,0,12" />

                        <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="8"
                                Padding="12" Margin="0,0,0,14" MaxHeight="190">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding UpdateNotes}" Foreground="{DynamicResource TextCol}"
                                           FontSize="12.5" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>

                        <ProgressBar Value="{Binding UpdateDownloadProgress, Mode=OneWay}" Maximum="100"
                                     Margin="0,0,0,12"
                                     Visibility="{Binding UpdateDownloading, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Downloaded. It installs when you close the app, or restart now."
                                   Foreground="{DynamicResource TrackingCol}" FontSize="12" Margin="0,0,0,12"
                                   Visibility="{Binding UpdateDownloaded, Converter={StaticResource BoolToVis}}" />

                        <Grid>
                            <Button Content="Later" Style="{StaticResource GhostButton}"
                                    Command="{Binding PostponeUpdateCommand}" HorizontalAlignment="Left"
                                    Visibility="{Binding UpdateDownloaded, Converter={StaticResource InvBoolToVis}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Download and install" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding AcceptUpdateCommand}" MinWidth="150"
                                        Visibility="{Binding UpdateDownloaded, Converter={StaticResource InvBoolToVis}}" />
                                <Button Content="Close" Style="{StaticResource GhostButton}"
                                        Command="{Binding CloseUpdateOverlayCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding UpdateDownloaded, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Restart now" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding RestartUpdateCommand}" MinWidth="110"
                                        Visibility="{Binding UpdateDownloaded, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- 3-2-1 countdown overlay (click to skip) -->
            <Border x:Name="CountdownOverlay" Background="{DynamicResource OverlayScrim}" Visibility="Collapsed"
                    MouseDown="OnCountdownClicked" Cursor="Hand">
                <TextBlock x:Name="CountdownText" Text="3" FontSize="180" FontWeight="Bold"
                           Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="CountdownScale" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Border>
        </Grid>
    </Grid>
</Window>
